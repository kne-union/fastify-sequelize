{
  "name": "@kne/fastify-sequelize",
  "version": "4.0.3",
  "description": "Fastify与Sequelize的深度集成插件，支持自动模型加载和分布式ID生成",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "test": "mocha tests/**/*.test.js",
    "test:coverage": "nyc --reporter=html --reporter=text mocha tests/**/*.test.js"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-sequelize.git"
  },
  "keywords": [
    "fastify-plugin",
    "sequelize-orm",
    "database-integration",
    "automatic-models",
    "distributed-ids"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-sequelize/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-sequelize#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "fastify": "^5.3.2",
    "husky": "^9.0.11",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "prettier": "^3.2.5",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "peerDependencies": {
    "fastify": ">=5",
    "sequelize": ">=6 <7"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.1",
    "fs-extra": "^11.3.1",
    "glob": "^11.0.0",
    "lodash": "^4.17.21",
    "nodejs-snowflake": "^2.0.1"
  }
}
